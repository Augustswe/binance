# ============================================================
# Binance 测试网 API 配置 (复制为 .env 后填写)
# ============================================================
# 测试网 Key 获取: https://testnet.binance.vision  (用GitHub账号登录, 创建API Key)
# 合约测试网的资金申请: 页面下方 "Request testnet funds" 按钮 (每次10,000 USDT)

# 交易模式: paper = 模拟下单(无需Key) / live = 真实测试网下单(需要Key)
TRADING_MODE=paper

# 测试网 API Key / Secret
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Telegram 通知 (可选, 留空则不推送)
# Bot Token: Telegram 找 @BotFather 发 /newbot 创建机器人获得
# Chat ID: 找 @userinfobot 查询你的 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
